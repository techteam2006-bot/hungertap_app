# Copy to .env — never commit .env. Use only the anon (publishable) key here, never service_role.
#
# APK / EAS build: add the same EXPO_PUBLIC_* vars in Expo dashboard → Project → Environment
# variables (preview/production), or: eas env:create --name EXPO_PUBLIC_SUPABASE_URL --value ...

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sentry (required for crash reporting). Use the same DSN in sentry.options.json for native startup crashes.
# EXPO_PUBLIC_SENTRY_DSN=https://YOUR_KEY@oXXXX.ingest.sentry.io/PROJECT_ID
# SENTRY_AUTH_TOKEN=  (EAS secret — uploads source maps / ProGuard mappings; never commit)
# SENTRY_ORG=trovox
# SENTRY_PROJECT=android
# Temporary crash probes (remove after verification): after-init | before-render | native | js-fatal
# EXPO_PUBLIC_SENTRY_CRASH_TEST=
# EXPO_PUBLIC_SENTRY_DEBUG=true

# Paid checkout: POST /functions/v1/create-order-v2 (defaults to $SUPABASE_URL/functions/v1/create-order-v2)
# EXPO_PUBLIC_CREATE_ORDER_V2_URL=https://YOUR_PROJECT.supabase.co/functions/v1/create-order-v2

DEV_IP=20.20.4.87
DEEP_LINK_PORT=8083
# Checkout uses Edge `create-order-v2` (or RPC `create_order_v2`) by default.
# EXPO_PUBLIC_USE_ORDER_HTTP=true
# Optional: order queue HTTP API base (requires POST /order + worker). Defaults to http://$DEV_IP:3000 when HTTP orders are enabled.
# EXPO_PUBLIC_ORDER_API_BASE=http://192.168.1.5:3000
#
# Menu is loaded via Edge Function get-canteen-menu by default (not direct `items` table reads).
# Query param is `canteen_id`. Optional override:
# EXPO_PUBLIC_GET_CANTEEN_MENU_URL=https://mgyfyutxtapgggcwkknw.supabase.co/functions/v1/get-canteen-menu
#
# Load menu from a custom backend GET /api/menu instead (same host as ORDER_API_BASE by default).
# EXPO_PUBLIC_MENU_FROM_HTTP=true
# EXPO_PUBLIC_MENU_HTTP_URL=http://192.168.1.5:3000/api/menu
#
# Order queue server (Express + Redis + BullMQ) lives in backend/ — copy backend/.env.example to backend/.env
# EXPO_PUBLIC_CART_STORAGE=local
