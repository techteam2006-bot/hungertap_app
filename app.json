{
  "expo": {
    "name": "HungerTap",
    "slug": "canteen-app",
    "scheme": "hungertap",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "owner": "24951a66p9",
    "icon": "./assets/hungertap_launcher_icon.png",
    "splash": {
      "image": "./assets/hungertap-global-loading.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "assets/home-banner.webp",
      "assets/login-logo-transparent.png",
      "assets/hungertap-global-loading.png",
      "assets/no-items-empty-state.png",
      "assets/fonts/*.ttf"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hungertap.app"
    },
    "android": {
      "package": "com.hungertap.app",
      "googleServicesFile": "./google-services.json",
      "icon": "./assets/hungertap_launcher_icon.png",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "INTERNET",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "hungertap"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/hungertap_launcher_icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-dev-client",
      "expo-asset",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "reactNativeArchitectures": [
              "arm64-v8a"
            ]
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f0221b0e-e5d9-4440-b318-04caa10549cd"
      }
    },
    "newArchEnabled": false
  }
}
