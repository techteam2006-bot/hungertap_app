{
  "cli": {
    "version": ">= 5.9.1",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "SENTRY_ENVIRONMENT": "development",
        "SENTRY_ORG": "trovox",
        "SENTRY_PROJECT": "android",
        "SENTRY_ALLOW_FAILURE": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "SENTRY_ENVIRONMENT": "preview",
        "SENTRY_ORG": "trovox",
        "SENTRY_PROJECT": "android",
        "SENTRY_ALLOW_FAILURE": "true"
      }
    },
    "apk": {
      "extends": "preview",
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      },
      "env": {
        "SENTRY_ENVIRONMENT": "preview",
        "SENTRY_ORG": "trovox",
        "SENTRY_PROJECT": "android",
        "SENTRY_ALLOW_FAILURE": "true"
      }
    },
    "production": {
      "developmentClient": false,
      "distribution": "store",
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "remote"
      },
      "env": {
        "SENTRY_ENVIRONMENT": "production",
        "SENTRY_ORG": "trovox",
        "SENTRY_PROJECT": "android",
        "SENTRY_ALLOW_FAILURE": "true",
        "SENTRY_RELEASE": "com.hungertap.app@1.0.4+6",
        "SENTRY_DIST": "6"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
