{
  "name": "canteen-app",
  "version": "1.0.0",
  "type": "commonjs",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "npx expo start",
    "android": "npx expo run:android",
    "ios": "npx expo run:ios",
    "web": "npx expo start --web",
    "measure-bundle": "node scripts/measureBundle.mjs",
    "prebuild:android": "npx expo prebuild --platform android --clean",
    "build:apk": "eas build --platform android --profile apk --non-interactive",
    "build:playstore": "eas build --platform android --profile production --non-interactive",
    "build:apk:local": "cd android && gradlew.bat assembleRelease",
    "build:apk:local:debug": "cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "@react-navigation/stack": "^6.3.20",
    "@supabase/supabase-js": "^2.105.3",
    "expo": "~54.0.34",
    "expo-asset": "~12.0.12",
    "expo-auth-session": "~7.0.11",
    "expo-background-fetch": "~14.0.9",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-font": "^14.0.9",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.1.10",
    "expo-dev-client": "~6.0.21",
    "typescript": "~5.9.2"
  },
