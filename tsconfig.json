{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "jsx": "react-native",
    "strict": false,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "types": ["react", "react-native"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true
  },
  "include": [
    "App.js",
    "index.js",
    "app.config.js",
    "babel.config.js",
    "config.js",
    "components/**/*.js",
    "lib/**/*.js",
    "screens/**/*.js",
    "utils/**/*.js",
    "scripts/**/*.js",
    "scripts/**/*.mjs"
  ],
  "exclude": [
    "node_modules",
    "android",
    ".expo",
    "supabase_edge_function_*.ts",
    "supabase/functions/**"
  ]
}
